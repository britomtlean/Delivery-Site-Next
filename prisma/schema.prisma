generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type PedidosProdutos {
  Nome          String
  ProdutoId     String
  Quantidade    Int
  Subtotal      Float
  ValorUnitario Float
}

model Categoria {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  Imagem String
  Login  String
  Nome   String
}

model PedidoCliente {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  Contato String
  Data    DateTime @db.Date
  Login   String
  Nome    String
  Produto String
}

model Pedidos {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  ContatoCliente  String
  DataPedido      DateTime          @db.Date
  EnderecoCliente String
  NomeCliente     String
  Produtos        PedidosProdutos[]
  Status          Boolean?
  StatusEntrega   String?
  Loja   String?
  ValorTotal      Float
}

model Produtos {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  categoria       String?
  /// Could not determine type: the field only had null or empty values in the sample set.
  codigoBarra     Json?
  data_criacao    DateTime @db.Date
  descricao       String
  disponibilidade Boolean
  estoque         Int
  imagem          String
  login           String
  nome            String
  valor           String
}

model Promocoes {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  Descricao    String
  Imagem       String
  Login        String
  Visibilidade Boolean
}

model Usuarios {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  Background String?
  Descricao  String
  Endereco   String
  Horario    String
  Instagram  String
  Logo       String
  Nome       String
  Senha      String
  WhatsApp   String
  user       String @unique
}
